[Unit]
Description=Educational Minigames Streamlit app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nierva
Group=nierva
WorkingDirectory=/opt/nierva-game
EnvironmentFile=/etc/nierva-game.env
ExecStart=/opt/nierva-game/.venv/bin/streamlit run /opt/nierva-game/nierva_app.py --server.address=127.0.0.1 --server.port=8501
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
